# Public base URL of the media bucket. Inlined into the client bundle at build
# time (it is a public URL, not a secret). Files resolve to
# ${NEXT_PUBLIC_MEDIA_BASE_URL}/<slug>/<file>, e.g. .../tedx-trailer/hd.mp4.
# Leave unset locally to serve from public/media. Required on Vercel.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com

# Storage credentials are NEVER set here or in Vercel: uploads use
# `npx wrangler login` on your machine (see DEPLOYMENT.md).

# Public URL of the site (e.g. https://abhishekpandey.in). Used for absolute
# link-preview image URLs. Optional on Vercel.
# NEXT_PUBLIC_SITE_URL=https://example.com
